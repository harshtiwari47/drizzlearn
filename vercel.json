{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/handler.js" }
  ],
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60
    },
    "api/handler.js": {
      "maxDuration": 60
    }
  }
}
