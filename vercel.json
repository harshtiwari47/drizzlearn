{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/handler.js" },
    { "source": "/((?!api/|assets/|images/|favicon\\.ico|[^/]+\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60
    },
    "api/handler.js": {
      "maxDuration": 60
    }
  }
}
